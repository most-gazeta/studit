# Шаблон для сборки под ваш хостинг PHP + MySQL.
#
# Скопируйте файл в .env.production и соберите проект:
#   cp .env.production.example .env.production
#   npm run build
#
# VITE_API_URL — полный базовый URL API (включая сегмент /api).
# Для cPanel, где папка server-php загружена в public_html/api,
# подходит относительный путь — работает на любом домене:
VITE_API_URL=/api

# Для локального Node-сервера (server/) было бы:
# VITE_API_URL=http://localhost:3001/api
